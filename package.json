{
  "name": "nuers-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:document",
    "build:static": "tsc -b && vite build --config vite.static.config.ts",
    "build:all": "npm run build && npm run build:static",
    "build:document": "node scripts/build-document-renderer.mjs",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/*.{mjs,tsx}\" \"tests/js/*.mjs\" \"vite*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/*.{mjs,tsx}\" \"tests/js/*.mjs\" \"vite*.ts\"",
    "test": "node --test tests/js/*.test.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.6.0",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "6.4.299",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.15.1",
    "recharts": "^3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.2",
    "laravel-vite-plugin": "^2.0.0",
    "prettier": "3.6.2",
    "typescript": "~5.9.3",
    "vite": "^7.3.1"
  }
}
