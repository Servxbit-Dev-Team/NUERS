    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^11.18.2",
    "html-to-image": "^1.11.13",
    "input-otp": "^1.4.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.6.0",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
