# NUERS environment template. Copy to .env on the server and fill in real values there.
# Never commit a real .env, and never put real credentials in this file.
# After editing on a server: php artisan config:cache   (and php artisan route:cache)
# Before go-live: php artisan security:deployment-check

APP_NAME=NUERS
APP_ENV=production
APP_DEBUG=false
APP_URL=https://nuers.net
APP_TIMEZONE=UTC

# Generate ONCE with `php artisan key:generate`. Never regenerate on a system that already holds data: it encrypts
# stored documents, webhook secrets and SMTP settings. When rotating, move the old key to APP_PREVIOUS_KEYS (comma separated).
APP_KEY=
APP_PREVIOUS_KEYS=

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# --- Database (MySQL 8) -------------------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# Set to a CA bundle path when the database requires TLS (RDS/Aurora do in production).
MYSQL_ATTR_SSL_CA=

# --- Cache, sessions, queue ---------------------------------------------------------------------------------------
# These default to the database, which competes with invoice writes at high volume. For launch scale use Redis
# (and SQS or Redis for the queue). See docs/refactor-plan.md, step 5.
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database
# REDIS_HOST=
# REDIS_PORT=6379
# REDIS_PASSWORD=

# --- NUERS platform -------------------------------------------------------------------------------------------------
NUERS_SOLUTION_VERSION=1.0.0
# Reference of the approved configuration this release was accredited against. Required by security:deployment-check.
NUERS_APPROVED_CONFIGURATION=
# At least 10 characters. Evidence reference for this release (required by security:deployment-check).
NUERS_RELEASE_EVIDENCE_REFERENCE=
# At least 32 characters, random. Signs audit-chain checkpoints. Keep a copy in independent custody.
NUERS_AUDIT_CHECKPOINT_KEY=
NUERS_SESSION_IDLE_MINUTES=1440
NUERS_SESSION_MAX_MINUTES=10080
# Customer-facing email/SMS notifications stay off until a sender is configured and reviewed.
NUERS_NOTIFICATION_DISPATCH_ENABLED=false
NUERS_MERCHANT_WEBHOOK_DELIVERY_ENABLED=true

# --- PDF rendering (document copies are rendered by Node + headless Chromium) ---------------------------------------
NUERS_PDF_NODE=node
NUERS_PDF_CHROME=

# --- Mail ------------------------------------------------------------------------------------------------------------
# Platform SMTP settings are stored encrypted in the database and set in Admin. These only cover framework defaults.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# --- Google sign-in ---------------------------------------------------------------------------------------------------
# The SPA and /api must share one origin: the sign-in handoff uses a session cookie.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_FRONTEND_URL=

# --- Object storage (needed once uploads move off local disk) -----------------------------------------------------
FILESYSTEM_DISK=local
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-southeast-1
# AWS_BUCKET=
