# Production override checklist, not a complete environment file. Do not copy over a real .env.
# Preserve the existing application encryption key and its recovery custody; never regenerate it to deploy.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://nuers.net
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
# Supply via a reviewed secret store, not a committed file:
# NUERS_AUDIT_CHECKPOINT_KEY=<independently generated and custodied secret, at least 32 characters>
# NUERS_RELEASE_EVIDENCE_REFERENCE=<reviewed artifact/configuration/change approval reference>
# DB host/grants, TLS certificates, trusted proxy CIDRs, origin firewall and backups require actual deployment evidence.
# Official BIR transport and webhook delivery remain blocked by reviewed application code.
