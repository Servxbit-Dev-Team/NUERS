# NEW ISOLATED HOST ONLY. Not a production overlay and not evidence of a running staging service.
# Supply new secrets privately. Never reuse production APP_KEY, API keys, SMTP or BIR credentials.
APP_NAME="NUERS VAPT Staging"
APP_ENV=staging
APP_DEBUG=false
APP_URL=https://staging.nuers.net
APP_KEY=
DB_CONNECTION=mysql
DB_HOST=localhost
DB_SOCKET=/var/run/mysqld/mysqld.sock
DB_DATABASE=nuers_vapt_staging
DB_USERNAME=nuers_vapt_runtime
DB_PASSWORD=
DB_URL=
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_COOKIE=nuers_vapt_session
SESSION_DOMAIN=staging.nuers.net
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
MAIL_MAILER=array
NUERS_NOTIFICATION_DISPATCH_ENABLED=false
NUERS_MERCHANT_WEBHOOK_DELIVERY_ENABLED=false
BIR_EIS_OUTBOUND_ENABLED=false
BIR_EIS_CALLBACK_ENABLED=false
NUERS_LOCAL_BACKUP_ENABLED=false
NUERS_AUDIT_CHECKPOINT_KEY=
