# Add these to the server's private .env. Do not commit actual credentials.
# Google Cloud OAuth client type: Web application.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Register this exact authorized redirect URI for local development:
GOOGLE_REDIRECT_URI=http://localhost:8001/auth/google/callback
GOOGLE_FRONTEND_URL=http://localhost:8001

# For the current live static frontend + Laravel /public API deployment use:
# GOOGLE_REDIRECT_URI=https://nuers.net/public/auth/google/callback
# GOOGLE_FRONTEND_URL=https://nuers.net
# Register the live URI in the same Google Cloud client (or a separate client).
# Configure the consent screen and test users in Google Cloud as appropriate.
# Keep an existing valid Laravel APP_KEY; OAuth uses encrypted session cookies.
# Run composer install, then:
# php artisan migrate --path=database/migrations/2026_10_15_000001_add_google_id_to_users_table.php --force
# php artisan config:clear
# Existing NUERS users only; no new accounts or roles are created by Google login.
# First-time email linking supports Gmail and verified Google Workspace domains.
