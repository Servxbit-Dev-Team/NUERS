{
  "openapi": "3.1.0",
  "info": {
    "title": "NUERS Developer API",
    "version": "2026-10-15",
    "description": "Implemented NUERS application routes. This is not an official BIR EIS API specification. Live BIR transport remains unavailable."
  },
  "servers": [
    {
      "url": "/",
      "description": "Current NUERS deployment origin; use its actual HTTPS origin outside localhost."
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "User-session token for workspace/admin routes; merchant API key may be used as Bearer only on merchant integration ingestion."
      },
      "MerchantKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-NUERS-API-Key"
      }
    }
  },
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "health",
        "summary": "API health",
        "description": "Basic application response. This is not database, queue or BIR gateway health.\n\n",
        "tags": [
          "Public utilities"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Successful response; review endpoint-specific status and example."
          }
        }
      }
    },
    "/api/integrations/transactions": {
      "post": {
        "operationId": "ingest",
        "summary": "Ingest a business transaction",
        "description": "Tenant-bound transaction ingestion with transactions:write scope, active-key and exact-IP policy checks, daily quota and taxpayer issuance gate.\n\nResponse shown is illustrative; successful issuance requires the actual current authority gates. Inspect the returned record, not this sample, for its state.\nMerchant is resolved from the API key; there is no caller-selected merchant_id. X-NUERS-API-Key takes precedence over Authorization: Bearer.\nA repeated merchant + external_reference returns HTTP 200 with duplicate=true and the existing transaction_id. Current replay handling does not compare a content hash; reconcile changed content and never reuse a reference for another transaction.\nNo Idempotency-Key header or public 1,000-item batch route is implemented for this endpoint.\nThe sandbox/live key label does not create an isolated financial ledger. Use the public developer sandbox for tests.\nThis endpoint enforces the issuance gate. It does not establish live BIR transmission or automatic authoritative acknowledgment.",
        "tags": [
          "Merchant integration"
        ],
        "security": [
          {
            "MerchantKeyHeader": []
          },
          {
            "BearerToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response; review endpoint-specific status and example."
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Forbidden scope/role/IP"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "State or authority conflict"
          },
          "422": {
            "description": "Validation failed"
          },
          "429": {
            "description": "Quota exceeded"
          },
          "500": {
            "description": "Server error"
          },
          "201": {
            "description": "Created record when the required gates pass."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "external_reference": {
                    "type": "string",
                    "description": "Stable source reference, up to 120 characters. Duplicate lookup is scoped to the API key\u2019s merchant.",
                    "maxLength": 120
                  },
                  "amount": {
                    "type": "number",
                    "description": "PHP units, >= 0. Required when gross_amount is absent.",
                    "minimum": 0
                  },
                  "gross_amount": {
                    "type": "number",
                    "description": "PHP units, >= 0. Required when amount is absent; takes precedence if both are sent.",
                    "minimum": 0
                  },
                  "tax_type": {
                    "type": "string",
                    "description": "vatable | vat_exempt | zero_rated | non_vat.",
                    "enum": [
                      "vatable",
                      "vat_exempt",
                      "zero_rated",
                      "non_vat"
                    ]
                  },
                  "vat_rate": {
                    "type": "number",
                    "description": "0\u2013100; defaults to 12 in the current calculation. Tax applicability must be independently approved.",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "vat_inclusive": {
                    "type": "boolean",
                    "description": "Defaults to true. For VAT-exclusive input, VAT is added to the supplied amount."
                  },
                  "source_system": {
                    "type": "string",
                    "description": "Source label, maximum 120 characters.",
                    "maxLength": 120
                  },
                  "channel": {
                    "type": "string",
                    "description": "Maximum 80 characters; defaults to api.",
                    "maxLength": 80
                  },
                  "transaction_type": {
                    "type": "string",
                    "description": "Maximum 80 characters; defaults to sale.",
                    "maxLength": 80
                  },
                  "payment_method": {
                    "type": "string",
                    "description": "Maximum 80 characters; defaults to cash. Payment metadata is separate from BIR acceptance.",
                    "maxLength": 80
                  },
                  "document_type": {
                    "type": "string",
                    "description": "vat_invoice | non_vat_invoice | vat_exempt_invoice | zero_rated_invoice | mixed_sales_invoice | payment_receipt | sales_invoice | official_receipt. These are NUERS identifiers, not a legal classification ruling.",
                    "enum": [
                      "vat_invoice",
                      "non_vat_invoice",
                      "vat_exempt_invoice",
                      "zero_rated_invoice",
                      "mixed_sales_invoice",
                      "payment_receipt",
                      "sales_invoice",
                      "official_receipt"
                    ]
                  },
                  "customer_name": {
                    "type": "string",
                    "description": "Up to 255 characters; omit in synthetic examples. Real data requires authorized handling.",
                    "maxLength": 255
                  },
                  "customer_tin": {
                    "type": "string",
                    "description": "Optional, up to 80 characters. Current request rule is string validation, not official BIR verification.",
                    "maxLength": 80
                  },
                  "branch": {
                    "type": "string",
                    "description": "Branch label, up to 255 characters.",
                    "maxLength": 255
                  },
                  "branch_name": {
                    "type": "string",
                    "description": "Branch name, up to 255 characters.",
                    "maxLength": 255
                  },
                  "branch_code": {
                    "type": "string",
                    "description": "Up to 80 characters. Confirm key-bound branch policy with the administrator.",
                    "maxLength": 80
                  },
                  "branch_type": {
                    "type": "string",
                    "description": "main | branch.",
                    "enum": [
                      "main",
                      "branch"
                    ]
                  },
                  "receipt_number": {
                    "type": "string",
                    "description": "Optional source document number, up to 120 characters; do not bypass approved numbering controls.",
                    "maxLength": 120
                  },
                  "items": {
                    "type": "array",
                    "description": "Accepted as an array. Current ingestion does not validate per-line schema or reconcile line totals; confirm supported item structure before production.",
                    "items": {}
                  }
                },
                "required": [
                  "external_reference",
                  "tax_type"
                ],
                "anyOf": [
                  {
                    "required": [
                      "amount"
                    ]
                  },
                  {
                    "required": [
                      "gross_amount"
                    ]
                  }
                ]
              },
              "example": {
                "external_reference": "TEST-POS-000001",
                "source_system": "demo_pos",
                "channel": "pos",
                "amount": 1120,
                "tax_type": "vatable",
                "vat_rate": 12,
                "vat_inclusive": true,
                "document_type": "sales_invoice",
                "payment_method": "cash",
                "branch_code": "MAIN",
                "items": [
                  {
                    "description": "Synthetic example item",
                    "quantity": 1,
                    "unit_price": 1120
                  }
                ]
              }
            }
          }
        }
      }
    },
