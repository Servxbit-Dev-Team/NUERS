{
  "openapi": "3.1.0",
  "info": {
    "title": "NUERS Developer API",
    "version": "2026-10-17.wallet",
    "description": "Implemented NUERS application routes. This is not an official BIR EIS API specification. Live BIR transport remains unavailable."
  },
  "servers": [
    {
      "url": "/",
      "description": "Current NUERS deployment origin; use its actual HTTPS origin outside localhost."
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "User-session token for workspace/admin routes; merchant API key may be used as Bearer only on merchant integration ingestion."
      },
      "MerchantKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-NUERS-API-Key"
      }
    }
  },
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "health",
        "summary": "API health",
        "description": "Basic application response. This is not database, queue or BIR gateway health.\n\n",
        "tags": [
          "Public utilities"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Successful response; review endpoint-specific status and example."
          }
        }
      }
    },
    "/api/integrations/transactions": {
      "post": {
        "operationId": "ingest",
        "summary": "Accept a finalized source event",
        "description": "Atomic tenant-bound financial intake, current prepaid wallet fee, active live key, exact branch/IP, shared quotas and taxpayer issuance gates.\n\nExample fee is illustrative; read GET /api/integrations/transactions/wallet for the current platform fee. API money input is PHP/pesos; wallet amounts are integer centavos.\nThe merchant comes from the key. Sandbox keys cannot write financial records.\nExact identity/content replay returns 200 and the original response without another fee. Conflicting content under an existing identity returns 409. Preserve original event ID, timestamp and number.\n402 returns code=INSUFFICIENT_WALLET_BALANCE, available_centavos, required_centavos, shortage_centavos and transaction_saved=false. No financial record, debit or numbering advance commits. Retain the source on the client and retry the same identity after funding.\nThe fee applies once per eligible finalized primary sale of PHP500 or above. Smaller sales, payment copies and accepted retries do not add a sale fee. Funding does not bypass branch, tax, series, authority or BIR delivery gates.",
        "tags": [
          "Merchant integration"
        ],
        "security": [
          {
            "MerchantKeyHeader": []
          },
          {
            "BearerToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response; review endpoint-specific status and example."
          },
          "401": {
            "description": "Authentication required"
          },
          "402": {
            "description": "Insufficient merchant prepaid wallet funds; financial intake not saved"
          },
          "403": {
            "description": "Forbidden scope/role/IP"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "State or authority conflict"
          },
          "422": {
            "description": "Validation failed"
          },
          "429": {
            "description": "Quota exceeded"
          },
          "500": {
            "description": "Server error"
          },
          "201": {
            "description": "Created record when the required gates pass."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "external_reference": {
                    "type": "string",
                    "description": "Stable source reference, up to 120 characters. Duplicate lookup is scoped to the API key\u2019s merchant.",
                    "maxLength": 120
                  },
                  "amount": {
                    "type": "number",
                    "description": "PHP units, >= 0. Required when gross_amount is absent.",
                    "minimum": 0
                  },
                  "gross_amount": {
                    "type": "number",
                    "description": "PHP units, >= 0. Required when amount is absent; takes precedence if both are sent.",
                    "minimum": 0
                  },
                  "tax_type": {
                    "type": "string",
                    "description": "vatable | vat_exempt | zero_rated | non_vat.",
                    "enum": [
                      "vatable",
                      "vat_exempt",
                      "zero_rated",
                      "non_vat"
                    ]
                  },
                  "vat_rate": {
                    "type": "number",
                    "description": "Supported tax rate, 0 or 12 according to tax treatment; server rejects inconsistent taxes.",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "vat_inclusive": {
                    "type": "boolean",
                    "description": "Defaults to true. For VAT-exclusive input, VAT is added to the supplied amount."
                  },
                  "source_system": {
                    "type": "string",
                    "description": "Source label, maximum 120 characters.",
                    "maxLength": 120
                  },
                  "channel": {
                    "type": "string",
                    "description": "Maximum 80 characters; defaults to api.",
                    "maxLength": 80
                  },
                  "transaction_type": {
                    "type": "string",
                    "description": "Maximum 80 characters; defaults to sale.",
                    "maxLength": 80
                  },
                  "payment_method": {
                    "type": "string",
                    "description": "Maximum 80 characters; defaults to cash. Payment metadata is separate from BIR acceptance.",
                    "maxLength": 80
                  },
                  "document_type": {
                    "type": "string",
                    "description": "vat_invoice | non_vat_invoice | vat_exempt_invoice | zero_rated_invoice | mixed_sales_invoice | payment_receipt | sales_invoice | official_receipt. These are NUERS identifiers, not a legal classification ruling.",
                    "enum": [
                      "vat_invoice",
                      "non_vat_invoice",
                      "vat_exempt_invoice",
                      "zero_rated_invoice",
                      "mixed_sales_invoice",
                      "payment_receipt",
                      "sales_invoice",
                      "official_receipt"
                    ]
                  },
                  "customer_name": {
                    "type": "string",
                    "description": "Up to 255 characters; omit in synthetic examples. Real data requires authorized handling.",
                    "maxLength": 255
                  },
                  "customer_tin": {
                    "type": "string",
                    "description": "Optional supported 9/12/14-digit TIN form; field validation is not BIR verification.",
                    "maxLength": 80
                  },
                  "branch": {
                    "type": "string",
                    "description": "Branch label, up to 255 characters.",
                    "maxLength": 255
                  },
                  "branch_name": {
                    "type": "string",
                    "description": "Branch name, up to 255 characters.",
                    "maxLength": 255
                  },
                  "branch_code": {
                    "type": "string",
                    "description": "Exact five-digit BIR branch code authorized by the key.",
                    "maxLength": 5,
                    "pattern": "^[0-9]{5}$"
                  },
                  "branch_type": {
                    "type": "string",
                    "description": "main | branch.",
                    "enum": [
                      "main",
                      "branch"
                    ]
                  },
                  "receipt_number": {
                    "type": "string",
                    "description": "Original finalized source number; must match the next configured authorized series.",
                    "maxLength": 120
                  },
                  "items": {
                    "type": "array",
                    "description": "1\u2013100 complete item lines. description, positive quantity, unit_price in PHP/pesos and supported tax treatment; server reconciles lines and gross total.",
                    "items": {
                      "type": "object",
                      "required": [
                        "description",
                        "quantity",
                        "unit_price"
                      ],
                      "properties": {
                        "description": {
                          "type": "string"
                        },
                        "quantity": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "unit_price": {
                          "type": [
                            "number",
                            "string"
                          ]
                        },
                        "tax_type": {
                          "enum": [
                            "vatable",
                            "non_vat",
                            "zero_rated",
                            "vat_exempt"
                          ]
                        }
                      }
                    },
                    "minItems": 1,
                    "maxItems": 100
                  },
                  "schema_version": {
                    "type": "string",
                    "description": "NUERS-ingestion-1",
                    "maxLength": 80,
                    "const": "NUERS-ingestion-1"
                  },
                  "source_event_id": {
                    "type": "string",
                    "description": "Stable source event ID, up to 120 characters.",
                    "maxLength": 80
                  },
                  "event_type": {
                    "type": "string",
                    "description": "invoice.finalized | payment.recorded. Payment evidence is not another sale.",
                    "maxLength": 80,
                    "enum": [
                      "invoice.finalized",
                      "payment.recorded"
                    ]
                  },
                  "occurred_at": {
                    "type": "string",
                    "description": "Original event timestamp with explicit timezone; preserve on every retry.",
                    "maxLength": 80
                  }
                },
                "required": [
                  "external_reference",
                  "tax_type",
                  "source_system",
                  "payment_method",
                  "document_type",
                  "branch_code",
                  "receipt_number",
                  "items",
                  "schema_version",
                  "source_event_id",
                  "event_type",
                  "occurred_at"
                ],
                "anyOf": [
                  {
                    "required": [
                      "amount"
                    ]
                  },
                  {
                    "required": [
                      "gross_amount"
                    ]
                  }
                ]
              },
              "example": {
                "external_reference": "TEST-POS-000001",
                "source_system": "demo_pos",
                "channel": "pos",
                "amount": 1120,
                "tax_type": "vatable",
                "vat_rate": 12,
                "vat_inclusive": true,
                "document_type": "sales_invoice",
                "payment_method": "cash",
                "branch_code": "00000",
                "items": [
                  {
                    "description": "Synthetic example item",
                    "quantity": 1,
                    "unit_price": 1120
                  }
                ],
                "schema_version": "NUERS-ingestion-1",
                "source_event_id": "TEST-EVENT-000001",
                "event_type": "invoice.finalized",
                "occurred_at": "2026-10-17T10:00:00+08:00",
                "receipt_number": "TEST-00000001"
              }
            }
          }
        }
      }
    },
    "/api/business-accounts/current": {
      "get": {
        "operationId": "account",
        "summary": "Current business account",
        "description": "Retrieve the business linked to the authenticated user. Use the user session token, not a merchant integration key.\n\n",
        "tags": [
          "Merchant workspace"
        ],
        "security": [
          {
            "BearerToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response; review endpoint-specific status and example."
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/api/merchant/transactions": {
      "get": {
        "operationId": "transactions",
        "summary": "List merchant transactions",
        "description": "Tenant-scoped transaction list and recorded summaries.\n\n",
        "tags": [
          "Merchant workspace"
        ],
        "security": [
          {
            "BearerToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response; review endpoint-specific status and example."
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Not found"
          }
        },
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Default 1.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "description": "5\u2013100; default 15.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "description": "Search the supported transaction fields.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Filter by stored transaction status.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "channel",
            "in": "query",
            "required": false,
            "description": "Filter by source channel.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "branch",
            "in": "query",
            "required": false,
            "description": "Filter by branch label.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "payment",
            "in": "query",
            "required": false,
            "description": "Filter by payment method.",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/merchant/api-keys": {
      "get": {
        "operationId": "keys",
        "summary": "List merchant API keys",
        "description": "List masked key metadata for the authenticated merchant. Stored plaintext keys are not returned.\n\n",
        "tags": [
          "Credentials"
        ],
        "security": [
          {
            "BearerToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response; review endpoint-specific status and example."
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Not found"
          }
        }
      },
      "post": {
        "operationId": "create-key",
        "summary": "Create merchant API key",
        "description": "Create a tenant-bound machine credential. The response contains plain_key once; store it in approved secret storage.\n\nUser-session authorization and an existing merchant association are required. This operation creates access; the public sandbox does not execute it.\nKey management is available through the merchant API-key dashboard. Never paste a real key into the public sandbox.",
        "tags": [
          "Credentials"
        ],
        "security": [
          {
            "BearerToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response; review endpoint-specific status and example."
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Not found"
          },
          "422": {
            "description": "Validation failed"
          },
          "201": {
            "description": "Created record when the required gates pass."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Maximum 255 characters."
                  },
                  "environment": {
                    "type": "string",
                    "description": "live | sandbox. Label alone is not sandbox isolation."
                  },
                  "scopes": {
                    "type": "array",
                    "description": "Explicit scope strings; transactions:write is required for transaction ingestion.",
                    "items": {}
                  },
                  "ip_whitelist": {
                    "type": "array",
                    "description": "Exact source IP strings. CIDR matching is not implemented in ingestion.",
                    "items": {}
                  },
                  "rate_limit_per_day": {
                    "type": "integer",
                    "description": "100\u20131,000,000. Defaults are 50,000 live / 5,000 sandbox."
                  },
                  "branch_type": {
                    "type": "string",
                    "description": "main | branch."
                  },
                  "branch_code": {
                    "type": "string",
                    "description": "Maximum 80 characters."
                  },
                  "branch_name": {
                    "type": "string",
                    "description": "Maximum 255 characters."
                  },
                  "branch_location": {
                    "type": "string",
                    "description": "Maximum 255 characters."
                  }
                },
                "required": [
                  "name",
                  "environment"
                ]
              },
              "example": {
                "name": "Example POS connector",
                "environment": "sandbox",
                "scopes": [
                  "transactions:write"
                ],
                "ip_whitelist": [],
                "rate_limit_per_day": 5000
              }
            }
          }
        }
      }
    },
    "/api/merchant/api-keys/{id}": {
      "patch": {
        "operationId": "key-update",
        "summary": "Update merchant API key policy",
        "description": "Update permitted metadata and access policy for an owned key. No rotate flag is implemented.\n\nFor replacement: create a new key, update authorized consumers, verify readiness and then revoke the old key. There is no atomic rotate endpoint.",
        "tags": [
          "Credentials"
        ],
        "security": [
          {
            "BearerToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response; review endpoint-specific status and example."
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Not found"
          },
          "422": {
            "description": "Validation failed"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Updated key name."
                  },
                  "active": {
                    "type": "boolean",
                    "description": "true enables; false makes the owned key inactive."
                  },
                  "scopes": {
                    "type": "array",
                    "description": "Replacement scope strings.",
                    "items": {}
                  },
                  "ip_whitelist": {
                    "type": "array",
                    "description": "Replacement exact-IP allowlist.",
                    "items": {}
                  },
                  "rate_limit_per_day": {
                    "type": "integer",
                    "description": "100\u20131,000,000."
                  },
                  "branch_type": {
                    "type": "string",
                    "description": "main | branch."
                  },
                  "branch_code": {
                    "type": "string",
                    "description": "Maximum 80 characters."
                  },
                  "branch_name": {
                    "type": "string",
                    "description": "Maximum 255 characters."
                  },
                  "branch_location": {
                    "type": "string",
                    "description": "Maximum 255 characters."
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "key-revoke",
        "summary": "Revoke a merchant API key",
        "description": "Deactivate an owned API key through the controlled key-management route.\n\nThis changes access. The documentation and public sandbox never execute it automatically.",
        "tags": [
          "Credentials"
        ],
        "security": [
          {
            "BearerToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response; review endpoint-specific status and example."
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Not found"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/bir-eis/readiness": {
      "get": {
        "operationId": "readiness",
        "summary": "EIS readiness",
        "description": "Inspect recorded accreditation/taxpayer gates, checks and queue metadata. Authorized roles: admin, super_admin, bir.\n\nLocal readiness and registered credentials do not constitute BIR approval.",
        "tags": [
          "Administrative EIS"
        ],
        "security": [
          {
            "BearerToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response; review endpoint-specific status and example."
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Forbidden scope/role/IP"
          }
        }
      }
    },
    "/api/bir-eis/validate": {
      "post": {
        "operationId": "eis-validate",
        "summary": "Validate internal EIS payload",
        "description": "Validate the current NUERS structural payload requirements and return its canonical hash and deadline. This is not official BIR schema conformance.\n\nDefault timezone/display rules and the actual returned due_at govern this internal check. The example is dated and illustrative.\nValidation does not create a document, transmit it or establish tax correctness.",
        "tags": [
          "Administrative EIS"
        ],
        "security": [
          {
            "BearerToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response; review endpoint-specific status and example."
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Forbidden scope/role/IP"
          },
          "422": {
            "description": "Validation failed"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "payload": {
                    "type": [
                      "object",
                      "string"
                    ],
                    "description": "Object or JSON string. Current checker requires a document identifier, parseable issue/transaction date, Philippine-format seller TIN and a positive total."
                  }
                },
                "required": [
                  "payload"
                ]
              },
              "example": {
                "payload": {
                  "is_test": true,
                  "invoice_number": "TEST-INV-000001",
                  "issue_date": "2026-10-15",
                  "seller_tin": "999999999000",
                  "total_due": 1120,
                  "document_type": "sales_invoice"
                }
              }
            }
          }
        }
      }
    },
    "/api/bir-eis/transmissions": {
      "post": {
        "operationId": "eis-queue",
        "summary": "Queue certification payload",
        "description": "Record an eligible internal transmission intent. Certification requires payload.is_test=true; production is blocked until the separate authority and transport gates pass.\n\nThis endpoint writes queue and audit records. The public sandbox does not call it.\nDocument identity includes seller, branch, document type and number within an environment. Same identity/hash returns the original; changed content is rejected with 409.\nA queued or simulated certification acknowledgment is not BIR acceptance.",
        "tags": [
          "Administrative EIS"
        ],
        "security": [
          {
            "BearerToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response; review endpoint-specific status and example."
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Forbidden scope/role/IP"
          },
          "409": {
            "description": "State or authority conflict"
          },
          "422": {
            "description": "Validation failed"
          },
          "201": {
            "description": "Created record when the required gates pass."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "environment": {
                    "type": "string",
                    "description": "certification | production; default certification."
                  },
                  "payload": {
                    "type": [
                      "object",
                      "string"
                    ],
                    "description": "Internal EIS payload. Use explicit synthetic test data only in certification."
                  }
                },
                "required": [
                  "payload"
                ]
              },
              "example": {
                "environment": "certification",
                "payload": {
                  "is_test": true,
                  "invoice_number": "TEST-INV-000001",
                  "issue_date": "2026-10-15",
                  "seller_tin": "999999999000",
                  "total_due": 1120,
                  "document_type": "sales_invoice"
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "eis-list",
        "summary": "List recorded transmissions",
        "description": "Search recorded queue states and attempts.\n\n",
        "tags": [
          "Administrative EIS"
        ],
        "security": [
          {
            "BearerToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response; review endpoint-specific status and example."
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Forbidden scope/role/IP"
          },
          "422": {
            "description": "Validation failed"
          }
        },
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Positive page number.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "description": "1\u2013100.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "environment",
            "in": "query",
            "required": false,
            "description": "all | production | certification | sandbox.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "description": "Transaction/document/taxpayer search.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Stored transmission status.",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
