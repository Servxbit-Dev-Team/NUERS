    "/api/bir-eis/validate": {
      "post": {
        "operationId": "eis-validate",
        "summary": "Validate internal EIS payload",
        "description": "Validate the current NUERS structural payload requirements and return its canonical hash and deadline. This is not official BIR schema conformance.\n\nDefault timezone/display rules and the actual returned due_at govern this internal check. The example is dated and illustrative.\nValidation does not create a document, transmit it or establish tax correctness.",
        "tags": [
          "Administrative EIS"
        ],
        "security": [
          {
            "BearerToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response; review endpoint-specific status and example."
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Forbidden scope/role/IP"
          },
          "422": {
            "description": "Validation failed"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "payload": {
                    "type": [
                      "object",
                      "string"
                    ],
                    "description": "Object or JSON string. Current checker requires a document identifier, parseable issue/transaction date, Philippine-format seller TIN and a positive total."
                  }
                },
                "required": [
                  "payload"
                ]
              },
              "example": {
                "payload": {
                  "is_test": true,
                  "invoice_number": "TEST-INV-000001",
                  "issue_date": "2026-10-15",
                  "seller_tin": "999999999000",
                  "total_due": 1120,
                  "document_type": "sales_invoice"
                }
              }
            }
          }
        }
      }
    },
    "/api/bir-eis/transmissions": {
      "post": {
        "operationId": "eis-queue",
        "summary": "Queue certification payload",
        "description": "Record an eligible internal transmission intent. Certification requires payload.is_test=true; production is blocked until the separate authority and transport gates pass.\n\nThis endpoint writes queue and audit records. The public sandbox does not call it.\nDocument identity includes seller, branch, document type and number within an environment. Same identity/hash returns the original; changed content is rejected with 409.\nA queued or simulated certification acknowledgment is not BIR acceptance.",
        "tags": [
          "Administrative EIS"
        ],
        "security": [
          {
            "BearerToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response; review endpoint-specific status and example."
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Forbidden scope/role/IP"
          },
          "409": {
            "description": "State or authority conflict"
          },
          "422": {
            "description": "Validation failed"
          },
          "201": {
            "description": "Created record when the required gates pass."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "environment": {
                    "type": "string",
                    "description": "certification | production; default certification."
                  },
                  "payload": {
                    "type": [
                      "object",
                      "string"
                    ],
                    "description": "Internal EIS payload. Use explicit synthetic test data only in certification."
                  }
                },
                "required": [
                  "payload"
                ]
              },
              "example": {
                "environment": "certification",
                "payload": {
                  "is_test": true,
                  "invoice_number": "TEST-INV-000001",
                  "issue_date": "2026-10-15",
                  "seller_tin": "999999999000",
                  "total_due": 1120,
                  "document_type": "sales_invoice"
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "eis-list",
        "summary": "List recorded transmissions",
        "description": "Search recorded queue states and attempts.\n\n",
        "tags": [
          "Administrative EIS"
        ],
        "security": [
          {
            "BearerToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response; review endpoint-specific status and example."
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Forbidden scope/role/IP"
          },
          "422": {
            "description": "Validation failed"
          }
        },
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Positive page number.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "description": "1\u2013100.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "environment",
            "in": "query",
            "required": false,
            "description": "all | production | certification | sandbox.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "description": "Transaction/document/taxpayer search.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Stored transmission status.",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/developer/sandbox": {
      "post": {
        "operationId": "sandbox",
        "summary": "Run an isolated contract preview",
        "description": "Validate synthetic transaction fields using the same shared NUERS field rules/calculation service. No financial database writes or BIR network requests.\n\nActual HTTP 200 carries simulated_http_status for a scenario. It does not emit a real API 401/429 or authorize retry against a production system.\n20 requests/minute per limiter identity; 64 KB maximum request size; preview amount maximum PHP 1 billion.\nNo Authorization or X-NUERS-API-Key header is accepted. Synthetic customer TIN, if used, must be 999999999000.",
        "tags": [
          "Developer tools"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Successful response; review endpoint-specific status and example."
          },
          "413": {
            "description": "Payload too large"
          },
          "422": {
            "description": "Validation failed"
          },
          "429": {
            "description": "Quota exceeded"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "is_test": {
                    "type": "boolean",
                    "description": "Must be true.",
                    "const": true
                  },
                  "action": {
                    "type": "string",
                    "description": "validate | preview | scenario.",
                    "enum": [
                      "validate",
                      "preview",
                      "scenario"
                    ]
                  },
                  "payload": {
                    "type": "object",
                    "description": "Required for validate/preview. external_reference must start TEST-, DEMO- or SAMPLE-. No credentials or private keys."
                  },
                  "scenario": {
                    "type": "string",
                    "description": "For scenario: duplicate | conflict | unauthorized | forbidden | rate_limit | timeout | production_gate."
                  }
                },
                "required": [
                  "is_test",
                  "action"
                ],
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "action": {
                          "enum": [
                            "validate",
                            "preview"
                          ]
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "payload"
                      ]
                    }
                  }
                ]
              },
