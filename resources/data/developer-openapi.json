                    "type": "boolean",
                    "description": "Must be true.",
                    "const": true
                  },
                  "action": {
                    "type": "string",
                    "description": "validate | preview | scenario.",
                    "enum": [
                      "validate",
                      "preview",
                      "scenario"
                    ]
                  },
                  "payload": {
                    "type": "object",
                    "description": "Required for validate/preview. external_reference must start TEST-, DEMO- or SAMPLE-. No credentials or private keys."
                  },
                  "scenario": {
                    "type": "string",
                    "description": "For scenario: duplicate | conflict | unauthorized | forbidden | rate_limit | timeout | production_gate."
                  }
                },
                "required": [
                  "is_test",
                  "action"
                ],
                "allOf": [
                  {
                    "if": {
