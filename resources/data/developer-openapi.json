    "/api/developer/sandbox": {
      "post": {
        "operationId": "sandbox",
        "summary": "Run an isolated contract preview",
        "description": "Validate synthetic transaction fields using the same shared NUERS field rules/calculation service. No financial database writes or BIR network requests.\n\nActual HTTP 200 carries simulated_http_status for a scenario. It does not emit a real API 401/429 or authorize retry against a production system.\n20 requests/minute per limiter identity; 64 KB maximum request size; preview amount maximum PHP 1 billion.\nNo Authorization or X-NUERS-API-Key header is accepted. Synthetic customer TIN, if used, must be 999999999000.",
        "tags": [
          "Developer tools"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Successful response; review endpoint-specific status and example."
          },
          "413": {
            "description": "Payload too large"
          },
          "422": {
            "description": "Validation failed"
          },
          "429": {
            "description": "Quota exceeded"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
